// # oocmp Command Line Options Parser
//
// Logline: Parses command-line flags, file paths, byte skips, and comparison limits.
//
// Setup: Decodes standard POSIX cmp options into typed comparison configurations.
//
// Beats:
//   1. Declare CmpCliOpts structure encapsulating files and options.
//   2. Parse integer skip and limit parameters.
//   3. Handle flags for verbose, print-bytes, quiet, demo, json, and mcp.
//   4. Supply initialized default option records.

import "ipc/json_field.oo";

pub type CmpCliOpts = struct {
    file1: String,
    file2: String,
    skip1: Int,
    skip2: Int,
    limit_bytes: Int,
    print_bytes: Bool,
    verbose_all: Bool,
    silent: Bool,
    demo: Bool,
    json: Bool,
    mcp: Bool,
    help: Bool,
    version: Bool
};

pub fn make_default_cli_opts() -> CmpCliOpts {
    return CmpCliOpts {
        file1: "",
        file2: "",
        skip1: 0,
        skip2: 0,
        limit_bytes: -1,
        print_bytes: false,
        verbose_all: false,
        silent: false,
        demo: false,
        json: false,
        mcp: false,
        help: false,
        version: false
    };
}

pub fn parse_cli_args(args: List[String]) -> CmpCliOpts {
    let mut opts: CmpCliOpts = make_default_cli_opts();
    let num_args: Int = list_len(args);
    let mut i: Int = 0;
    let mut pos_count: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);

        if arg == "-h" || arg == "--help" {
            opts.help = true;
        } else if arg == "-V" || arg == "-v" || arg == "--version" {
            opts.version = true;
        } else if arg == "--mcp" {
            opts.mcp = true;
        } else if arg == "--demo" {
            opts.demo = true;
        } else if arg == "--json" {
            opts.json = true;
        } else if arg == "-b" || arg == "--print-bytes" {
            opts.print_bytes = true;
        } else if arg == "-l" || arg == "--verbose" {
            opts.verbose_all = true;
        } else if arg == "-s" || arg == "--quiet" || arg == "--silent" {
            opts.silent = true;
        } else if str_starts_with(arg, "-n") {
            let mut n_str: String = "";
            if chars_len(arg) > 2 {
                n_str = str_slice(arg, 2, chars_len(arg));
            } else if i + 1 < num_args {
                i = i + 1;
                n_str = list_get(args, i);
            }
            if chars_len(n_str) > 0 {
                opts.limit_bytes = parse_int(n_str, -1);
            }
        } else if str_starts_with(arg, "-i") {
            let mut i_str: String = "";
            if chars_len(arg) > 2 {
                i_str = str_slice(arg, 2, chars_len(arg));
            } else if i + 1 < num_args {
                i = i + 1;
                i_str = list_get(args, i);
            }
            let colon: Int = str_index_of(i_str, ":");
            if colon >= 0 {
                let s1: String = str_slice(i_str, 0, colon);
                let s2: String = str_slice(i_str, colon + 1, chars_len(i_str));
                opts.skip1 = parse_int(s1, 0);
                opts.skip2 = parse_int(s2, 0);
            } else if chars_len(i_str) > 0 {
                let s: Int = parse_int(i_str, 0);
                opts.skip1 = s;
                opts.skip2 = s;
            }
        } else if !str_starts_with(arg, "-") {
            if pos_count == 0 {
                opts.file1 = arg;
                pos_count = pos_count + 1;
            } else if pos_count == 1 {
                opts.file2 = arg;
                pos_count = pos_count + 1;
            } else if pos_count == 2 {
                opts.skip1 = parse_int(arg, 0);
                pos_count = pos_count + 1;
            } else if pos_count == 3 {
                opts.skip2 = parse_int(arg, 0);
                pos_count = pos_count + 1;
            }
        }

        i = i + 1;
    }

    return opts;
}
